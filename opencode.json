{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -r /*": "deny",
      "sudo *": "deny",
      "git push *main*": "deny",
      "git push *master*": "deny",
      "git push origin main": "deny",
      "git push origin master": "deny"
    },
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "ask"
  }
}
